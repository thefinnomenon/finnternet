<div class="demo-preview-page">
  <div class="project-layout">
    <div class="project-info-panel">
      <slot name="details" />
    </div>
    <div class="project-demo-panel">
      <slot name="demo" />
    </div>
  </div>
</div>

<style>
  .demo-preview-page {
    width: min(1340px, calc(100% - 40px));
    margin: 36px auto 64px;
  }
  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    grid-template-areas: 'demo details';
    gap: 24px;
    align-items: start;
  }
  .project-info-panel {
    grid-area: details;
    min-width: 0;
  }
  .project-demo-panel {
    grid-area: demo;
    min-width: 0;
    position: sticky;
    top: min(
      var(--space-6),
      calc(100svh - var(--demo-panel-height, 0px) - var(--space-6))
    );
  }
  @media (max-width: 1039px) {
    .project-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'details' 'demo';
      gap: 22px;
    }
    .project-demo-panel {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .demo-preview-page {
      width: min(100% - 20px, 1160px);
      margin-top: 22px;
    }
  }
</style>

<script>
  const demoPanel = document.querySelector('.project-demo-panel');
  if (demoPanel instanceof HTMLElement) {
    // Taller demos scroll into view before sticking; resizing stays supported.
    new ResizeObserver(() => {
      demoPanel.style.setProperty(
        '--demo-panel-height',
        `${demoPanel.offsetHeight}px`,
      );
    }).observe(demoPanel);
  }
</script>
