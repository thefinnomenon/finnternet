---
interface Props {
  name:
    | 'arrow'
    | 'check'
    | 'image'
    | 'loader'
    | 'sparkles'
    | 'download'
    | 'share'
    | 'mail';
  label?: string;
  size?: number;
}
const { name, label, size = 18 } = Astro.props;
---

<svg
  class:list={{ spin: name === 'loader' }}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {name === 'arrow' && (
    <>
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </>
  )}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'image' && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <circle cx="9" cy="10" r="2" />
      <path d="m21 15-5-5L5 20" />
    </>
  )}
  {name === 'loader' && <path d="M21 12a9 9 0 1 1-6.2-8.6" />}
  {name === 'sparkles' && (
    <>
      <path d="m12 3-1.4 3.6L7 8l3.6 1.4L12 13l1.4-3.6L17 8l-3.6-1.4L12 3Z" />
      <path d="m5 14-.8 2.2L2 17l2.2.8L5 20l.8-2.2L8 17l-2.2-.8L5 14Z" />
    </>
  )}
  {name === 'download' && (
    <>
      <path d="M12 3v12" />
      <path d="m7 10 5 5 5-5" />
      <path d="M5 21h14" />
    </>
  )}
  {name === 'share' && (
    <>
      <circle cx="18" cy="5" r="3" />
      <circle cx="6" cy="12" r="3" />
      <circle cx="18" cy="19" r="3" />
      <path d="m8.6 10.5 6.8-4" />
      <path d="m8.6 13.5 6.8 4" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </>
  )}
</svg>
