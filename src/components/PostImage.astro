---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
---

<figure class="post-image">
  <Image
    src={src}
    alt={alt}
    format="webp"
    quality={80}
    widths={[360, 720, 1080, 1440]}
    sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 800px) calc(100vw - 116px), (max-width: 1000px) calc(100vw - 320px), (max-width: 1160px) calc(100vw - 374px), 786px"
    layout="constrained"
    priority={priority}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
