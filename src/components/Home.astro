---
import Base from '../layouts/Base.astro';
import Window from './Window.astro';
import Computer from './Computer.astro';
import PixelIcon from './PixelIcon.astro';
import PostList from './PostList.astro';
import SpringPlayground from './SpringPlayground';
import { locales, localePath, translations, type Locale } from '../lib/i18n';
import { postsForLocale, postPath } from '../lib/posts';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations[locale];
const posts = await postsForLocale(locale);
const experimentPost = posts.find(
  (post) => post.data.translationKey === 'springs',
);
const alternates = Object.fromEntries(
  locales.map((lang) => [lang, localePath(lang)]),
);
---

<Base
  title="Finnternet"
  description={t.intro}
  locale={locale}
  alternates={alternates}
>
  <div class="desktop-layout">
    <nav class="desktop-folders" aria-label={t.home}>
      <a href={localePath(locale, 'writing')}>
        <PixelIcon name="folder" size={48} />
        <span>{t.writing}</span>
      </a>
      <a href={localePath(locale, 'projects')}>
        <PixelIcon name="folder" size={48} />
        <span>{t.projects}</span>
      </a>
      <a href={localePath(locale, 'about')}>
        <PixelIcon name="document" size={42} />
        <span>{t.about}</span>
      </a>
    </nav>
    <div class="desktop-windows">
      <Window title={t.welcome} class="welcome-window">
        <div class="welcome-copy">
          <h1>{t.hello}</h1>
          <p class="welcome-tagline">{t.tagline}</p>
          <p class="welcome-description">{t.intro}</p>
          <a class="text-link" href={localePath(locale, 'writing')}>
            {t.browse} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <Computer />
      </Window>
      <div class="home-columns">
        <Window title={t.latest} class="writing-window">
          <PostList posts={posts.slice(0, 3)} locale={locale} />
          <a class="window-bottom-link" href={localePath(locale, 'writing')}>
            {t.allWriting} <span aria-hidden="true">→</span>
          </a>
        </Window>
        <Window title={t.projects} class="projects-window">
          <a class="project-folder" href={localePath(locale, 'projects')}>
            <PixelIcon name="folder" size={46} />
            <span>{t.playground}</span>
            <span aria-hidden="true">↗</span>
          </a>
          <p class="project-description">{t.springProject}</p>
        </Window>
      </div>
      <Window title={t.experiment} class="experiment-window">
        <SpringPlayground locale={locale} compact client:visible />
        {experimentPost && (
          <a class="window-bottom-link" href={postPath(experimentPost)}>
            {t.experimentLink} <span aria-hidden="true">→</span>
          </a>
        )}
      </Window>
    </div>
  </div>
</Base>
