---
import Base from '../layouts/Base.astro';
import Window from './Window.astro';
import Computer from './Computer.astro';
import PixelIcon from './PixelIcon.astro';
import PostList from './PostList.astro';
import WorkHistory from './WorkHistory.astro';
import { locales, localePath, translations, type Locale } from '../lib/i18n';
import { postsForLocale } from '../lib/posts';
import { projectEntries } from '../lib/portfolio';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations[locale];
const posts = await postsForLocale(locale);
const alternates = Object.fromEntries(
  locales.map((lang) => [lang, localePath(lang)]),
);
---

<Base
  title="Finnternet"
  description={t.intro}
  locale={locale}
  alternates={alternates}
>
  <div class="desktop-layout">
    <nav class="desktop-folders" aria-label={t.home}>
      <a href={localePath(locale, 'work')}>
        <PixelIcon name="folder" size={48} />
        <span>{t.work}</span>
      </a>
      <a href={localePath(locale, 'projects')}>
        <PixelIcon name="folder" size={48} />
        <span>{t.projects}</span>
      </a>
      <a href={localePath(locale, 'writing')}>
        <PixelIcon name="document" size={42} />
        <span>{t.writing}</span>
      </a>
      <a href={localePath(locale, 'about')}>
        <PixelIcon name="document" size={42} />
        <span>{t.about}</span>
      </a>
    </nav>
    <div class="desktop-windows">
      <Window title={t.welcome} class="welcome-window">
        <div class="welcome-copy">
          <h1>{t.hello}</h1>
          <p class="welcome-tagline">{t.tagline}</p>
          <p class="welcome-description">{t.intro}</p>
          <a class="text-link" href={localePath(locale, 'writing')}>
            {t.browse} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <Computer />
      </Window>
      <div class="home-columns">
        <aside class="home-work-rail" aria-label={t.work}>
          <Window title={t.work} class="work-window">
            <WorkHistory locale={locale} compact />
            <a class="window-bottom-link" href={localePath(locale, 'work')}>
              {t.allWork} <span aria-hidden="true">→</span>
            </a>
          </Window>
        </aside>
        <div class="home-main-column">
          <Window title={t.latest} class="writing-window">
            <PostList posts={posts.slice(0, 3)} locale={locale} />
            <a class="window-bottom-link" href={localePath(locale, 'writing')}>
              {t.allWriting} <span aria-hidden="true">→</span>
            </a>
          </Window>
          <Window title={t.projects} class="projects-window">
            {projectEntries.map((project) => (
              <div class="home-project">
                <a class="project-folder" href={project.href}>
                  <PixelIcon name="folder" size={46} />
                  <span>{project.title}</span>
                  <span aria-hidden="true">↗</span>
                </a>
                <p class="project-description">{t[project.descriptionKey]}</p>
              </div>
            ))}
          </Window>
        </div>
      </div>
    </div>
  </div>
</Base>
