---
import { translations, type Locale } from '../lib/i18n';
import { workEntries } from '../lib/portfolio';
import '../styles/resume.css';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const t = translations[locale];
const dateFormat = new Intl.DateTimeFormat(locale, {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const entries = [...workEntries].sort(
  (a, b) =>
    b.startedOn.localeCompare(a.startedOn) ||
    b.endedOn.localeCompare(a.endedOn),
);
---

<ol class:list={['resume-history', 'work-history', { compact }]}>
  {entries.map((entry) => (
    <li class="resume-row work-row">
      <article>
        <div class="resume-row-header">
          <div>
            <h2>
              {entry.href ? (
                <a
                  href={entry.href}
                  target={
                    entry.href.startsWith('https://') ? '_blank' : undefined
                  }
                  rel={
                    entry.href.startsWith('https://')
                      ? 'noopener noreferrer'
                      : undefined
                  }
                >
                  {entry.company}
                </a>
              ) : (
                entry.company
              )}
            </h2>
            <p class="resume-subtitle">{t[entry.roleKey]}</p>
          </div>
          <div class="resume-period">
            <p class="resume-dates">
              <time datetime={entry.startedOn}>
                {dateFormat.format(new Date(`${entry.startedOn}-01T00:00:00Z`))}
              </time>
              {' – '}
              <time datetime={entry.endedOn}>
                {dateFormat.format(new Date(`${entry.endedOn}-01T00:00:00Z`))}
              </time>
            </p>
            {entry.locationKey && (
              <p class="resume-location">{t[entry.locationKey]}</p>
            )}
          </div>
        </div>
        {entry.descriptionKey && (
          <p class="resume-description">{t[entry.descriptionKey]}</p>
        )}
      </article>
    </li>
  ))}
</ol>
