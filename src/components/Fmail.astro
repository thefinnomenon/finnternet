---
import PixelIcon from './PixelIcon.astro';
import { htmlLanguage, type Locale } from '../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="fmail" id="fmail" lang={htmlLanguage(locale)}>
  <button
    class="fmail-trigger"
    id="fmail-trigger"
    type="button"
    popovertarget="fmail-popover"
    aria-label="Fmail — Finnternet Mail"
    aria-expanded="false"
    title="Fmail — Finnternet Mail"
  >
    <PixelIcon name="mail" size={23} />
    <span class="fmail-badge" id="fmail-badge" hidden>
      0
    </span>
  </button>
  <div
    class="fmail-popover"
    id="fmail-popover"
    popover="auto"
    aria-labelledby="fmail-heading"
  >
    <header class="fmail-popover-header">
      <h2 id="fmail-heading">Fmail</h2>
      <span>Finnternet Mail</span>
    </header>
    <div class="fmail-empty" id="fmail-empty">
      <PixelIcon name="mail" size={30} />
      <p>No mail yet.</p>
    </div>
    <ul class="fmail-list" id="fmail-list" aria-label="Recent emails"></ul>
  </div>
  <dialog class="fmail-modal" id="fmail-modal" aria-labelledby="fmail-subject">
    <header class="fmail-modal-header">
      <span>
        <PixelIcon name="mail" size={22} /> Fmail
      </span>
      <button type="button" id="fmail-close" aria-label="Close email">
        ×
      </button>
    </header>
    <div class="fmail-envelope">
      <p>
        <span>From</span> InstaMosaic
      </p>
      <p>
        <span>To</span> user@finnternet.com
      </p>
      <time id="fmail-date"></time>
    </div>
    <article class="fmail-body">
      <h2 id="fmail-subject"></h2>
      <div id="fmail-content"></div>
    </article>
  </dialog>
  <span
    id="fmail-announcement"
    class="fmail-sr-only"
    role="status"
    aria-live="polite"
  ></span>
  <aside id="fmail-toast" class="fmail-toast" aria-label="New email" hidden>
    <button type="button" id="fmail-toast-open" class="fmail-toast-open">
      <span class="fmail-toast-icon">
        <PixelIcon name="mail" size={24} />
      </span>
      <span class="fmail-toast-copy">
        <span>Fmail · InstaMosaic</span>
        <strong id="fmail-toast-subject"></strong>
        <span id="fmail-toast-snippet"></span>
      </span>
    </button>
    <button
      type="button"
      id="fmail-toast-dismiss"
      class="fmail-toast-dismiss"
      aria-label="Dismiss email notification"
    >
      ×
    </button>
  </aside>
</div>

<style is:global>
  .fmail {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .fmail [hidden] {
    display: none !important;
  }
  .fmail button {
    font: inherit;
    color: var(--ink);
    cursor: pointer;
  }
  .fmail .fmail-trigger {
    display: grid;
    place-items: center;
    position: relative;
    width: 40px;
    height: 40px;
    padding: 7px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
  }
  .fmail .fmail-trigger:hover,
  .fmail .fmail-trigger[aria-expanded='true'] {
    border-color: var(--rule);
    background: var(--surface-muted);
  }
  .fmail .fmail-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    border: 1px solid var(--surface);
    background: var(--accent-fill);
    color: #22241f;
    font: 700 11px/16px var(--font-body);
    text-align: center;
    border-radius: 9px;
    font-variant-numeric: tabular-nums;
  }
  .fmail-popover {
    position: fixed;
    inset: auto;
    margin: 0;
    width: min(370px, calc(100vw - 24px));
    padding: 0;
    border: var(--frame-width) solid var(--frame);
    border-radius: var(--radius);
    box-shadow: 4px 4px 0 var(--shadow);
    background: var(--surface-raised);
    color: var(--ink);
    overflow: auto;
  }
  .fmail-popover-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--rule);
  }
  .fmail-popover-header h2 {
    font-size: 20px;
    letter-spacing: -0.5px;
  }
  .fmail-popover-header > span {
    font: 12px var(--font-mono);
    color: var(--muted);
  }
  .fmail-empty {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 36px 20px;
    color: var(--muted);
  }
  .fmail-empty p {
    font-size: 14px;
  }
  .fmail-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fmail-list li + li {
    border-top: 1px solid var(--rule);
  }
  .fmail .fmail-message {
    display: grid;
    gap: 6px;
    width: 100%;
    padding: 15px 18px;
    border: 0;
    background: var(--surface-raised);
    color: var(--ink);
    text-align: left;
  }
  .fmail .fmail-message:hover {
    background: var(--surface-muted);
  }
  .fmail-message-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .fmail-message-top time {
    font-size: 11px;
  }
  .fmail-message-subject {
    font-size: 14px;
    font-weight: 650;
    line-height: 1.4;
  }
  .fmail-message-snippet {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }
  .fmail-unread {
    color: var(--accent-text);
    font-size: 11px;
    font-weight: 650;
  }
  .fmail-modal {
    width: min(600px, calc(100% - 24px));
    max-height: calc(100dvh - 32px);
    overflow: auto;
    padding: 0;
    border: var(--frame-width) solid var(--frame);
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--surface-raised);
    box-shadow: 5px 5px 0 var(--shadow);
  }
  .fmail-modal::backdrop {
    background: rgb(0 0 0 / 45%);
  }
  .fmail-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--rule);
    background: var(--surface-muted);
  }
  .fmail-modal-header > span {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 650 14px var(--font-mono);
  }
  .fmail .fmail-modal-header button {
    min-width: 40px;
    min-height: 40px;
    padding: 0 10px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 24px;
  }
  .fmail-envelope {
    padding: 18px 24px;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
  }
  .fmail-envelope p + p {
    margin-top: 5px;
  }
  .fmail-envelope p > span {
    display: inline-block;
    color: var(--muted);
    min-width: 45px;
  }
  .fmail-envelope > time {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .fmail-body {
    padding: 28px 24px 32px;
    font-family: Arial, sans-serif;
  }
  .fmail-body h2 {
    font-size: 23px;
    line-height: 1.3;
    letter-spacing: 0;
    margin-bottom: 20px;
  }
  .fmail-body p {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 18px;
  }
  .fmail-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .fmail-toast {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 1000;
    display: flex;
    align-items: start;
    gap: 4px;
    width: min(390px, calc(100vw - 32px));
    padding: 10px;
    border: var(--frame-width) solid var(--frame);
    border-radius: var(--radius);
    box-shadow: 4px 4px 0 var(--shadow);
    background: var(--surface-raised);
    color: var(--ink);
  }
  .fmail .fmail-toast-open {
    display: flex;
    align-items: start;
    gap: 12px;
    flex: 1;
    min-width: 0;
    padding: 5px;
    border: 0;
    background: transparent;
    text-align: left;
  }
  .fmail-toast-icon {
    flex: 0 0 auto;
    padding-top: 3px;
  }
  .fmail-toast-copy {
    display: grid;
    gap: 5px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .fmail-toast-copy > span {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .fmail-toast-copy strong {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 650;
  }
  .fmail .fmail-toast-dismiss {
    display: grid;
    place-items: center;
    width: 32px;
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 24px;
  }
  @media (pointer: coarse) {
    .fmail .fmail-toast-dismiss {
      min-width: 44px;
      min-height: 44px;
    }
  }
  @media (pointer: coarse) {
    .fmail .fmail-trigger {
      min-width: 44px;
      min-height: 44px;
    }
  }
  @media (max-width: 600px) {
    .fmail-body {
      padding-inline: 20px;
    }
    .fmail-envelope {
      padding-inline: 20px;
    }
  }
</style>

<script>
  import '../lib/fmail-ui';
</script>
