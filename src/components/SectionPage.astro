---
import Base from '../layouts/Base.astro';
import Window from './Window.astro';
import PostList from './PostList.astro';
import Computer from './Computer.astro';
import { locales, localePath, translations, type Locale } from '../lib/i18n';
import { postsForLocale } from '../lib/posts';
import { projectEntries } from '../lib/portfolio';
export type Section = 'writing' | 'work' | 'projects' | 'about';
interface Props {
  locale: Locale;
  section: Section;
}
const { locale, section } = Astro.props;
const t = translations[locale];
const posts = await postsForLocale(locale);
const alternates = Object.fromEntries(
  locales.map((lang) => [lang, localePath(lang, section)]),
);
const description =
  section === 'writing'
    ? t.writingIntro
    : section === 'work'
      ? t.workIntro
      : section === 'projects'
        ? t.projectsIntro
        : t.aboutIntro;
---

<Base
  title={t[section]}
  description={description}
  locale={locale}
  path={section}
  alternates={alternates}
>
  <div class="section-page">
    <Window title={t[section]}>
      {section === 'writing' && (
        <>
          <>
            <div class="section-heading">
              <>
                <h1>{t.writing}</h1>
                <p>{t.writingIntro}</p>
              </>
            </div>
            <PostList posts={posts} locale={locale} />
          </>
        </>
      )}
      {section === 'work' && (
        <>
          <div class="section-heading">
            <h1>{t.work}</h1>
            <p>{t.workIntro}</p>
          </div>
          <article class="project-entry work-entry">
            <h2>
              <a href="/work/whistle/">Whistle</a>
            </h2>
            <p>{t.whistleDescription}</p>
            <p class="work-summary">{t.whistleBusiness}</p>
          </article>
        </>
      )}
      {section === 'projects' && (
        <>
          <>
            <div class="section-heading">
              <>
                <h1>{t.projects}</h1>
                <p>{t.projectsIntro}</p>
              </>
            </div>
            {projectEntries.map((project) => (
              <article class="project-entry">
                <h2>
                  <a href={project.href}>{project.title}</a>
                </h2>
                <p>{t[project.descriptionKey]}</p>
              </article>
            ))}
          </>
        </>
      )}
      {section === 'about' && (
        <div class="about-content">
          <>
            <div>
              <>
                <h1>{t.aboutTitle}</h1>
                <p>{t.aboutIntro}</p>
                <p>{t.aboutBody}</p>
                <p>{t.aboutLanguages}</p>
                <a class="text-link" href={localePath(locale, 'writing')}>
                  {t.aboutLink} <span aria-hidden="true">→</span>
                </a>
              </>
            </div>
            <Computer />
          </>
        </div>
      )}
    </Window>
  </div>
</Base>
