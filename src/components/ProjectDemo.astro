---
import Window from './Window.astro';
import PixelIcon from './PixelIcon.astro';
import { demoProjects, type DemoProject } from '../lib/demo-projects';
interface Props {
  project?: DemoProject;
}
const { project = 'instamosaic' } = Astro.props;
const { title } = demoProjects[project];
---

<section
  id="project-demo"
  class="project-demo"
  aria-label={title}
  data-demo-project={project}
>
  <div id="demo-stage" class="demo-stage">
    <div id="demo-browser" class="demo-browser">
      <Window title={title} class="demo-window">
        <iframe
          id={`${project}-frame`}
          src={`/demos/${project}/`}
          title={title}
          height="640"
          loading="lazy"
          allow="fullscreen; web-share; clipboard-write"
          sandbox="allow-scripts allow-same-origin allow-downloads allow-forms"
        ></iframe>
      </Window>
      <button
        type="button"
        id="demo-resize-handle"
        class="demo-resize-handle"
        aria-label={`Resize ${title} window`}
        aria-describedby="demo-resize-help"
      >
        <PixelIcon name="resize" size={18} />
      </button>
      <span id="demo-resize-help" class="resize-help">
        Drag this corner to resize the window, or use the arrow keys.
      </span>
    </div>
  </div>
</section>

<style>
  .demo-stage {
    display: flex;
    align-items: start;
    justify-content: center;
    min-width: 0;
  }
  .demo-browser {
    position: relative;
    width: 100%;
    max-width: 100%;
    height: 680px;
    min-width: min(320px, 100%);
    min-height: 360px;
    max-height: 860px;
  }
  .demo-browser :global(.window) {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .demo-browser :global(.window-bar) {
    flex: 0 0 auto;
  }
  .demo-browser :global(.window-body) {
    flex: 1;
    min-height: 0;
    padding: 0;
    overflow: hidden;
  }
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--surface);
  }
  .demo-resize-handle {
    position: absolute;
    right: 2px;
    bottom: 2px;
    display: grid;
    place-items: end;
    width: 28px;
    height: 28px;
    padding: 3px;
    border: 0;
    background: var(--surface);
    color: var(--ink);
    cursor: nwse-resize;
    touch-action: none;
  }
  .demo-browser.resizing iframe {
    pointer-events: none;
  }
  .resize-help {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 620px) {
    .demo-browser {
      width: 100% !important;
      height: min(720px, 78svh) !important;
      min-height: 420px;
    }
    .demo-resize-handle {
      display: none;
    }
  }
</style>

<script>
  import { getFmailStore } from '../lib/fmail';
  import { isDemoProject, type DemoProject } from '../lib/demo-projects';
  type Phase = 'form' | 'processing' | 'ready';
  type DemoMessage = { type: `${DemoProject}:state`; phase: Phase };
  function element<T extends HTMLElement>(
    selector: string,
    constructor: { new (): T },
  ): T {
    const node = document.querySelector(selector);
    if (!(node instanceof constructor))
      throw new Error(`Project element missing: ${selector}`);
    return node;
  }
  const projectId = element('#project-demo', HTMLElement).dataset.demoProject;
  if (!isDemoProject(projectId)) throw new Error('Unknown portfolio demo.');
  const frame = element(`#${projectId}-frame`, HTMLIFrameElement);
  const browser = element('#demo-browser', HTMLDivElement);
  const stage = element('#demo-stage', HTMLDivElement);
  const handle = element('#demo-resize-handle', HTMLButtonElement);
  const mail = getFmailStore();
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  let phase: Phase = 'form';
  let activeRun: string | null = null;
  let showInitialResult =
    new URLSearchParams(window.location.search).get('demo') === 'ready';
  let drag: {
    pointerId: number;
    x: number;
    y: number;
    width: number;
    height: number;
  } | null = null;

  function send(message: object): void {
    frame.contentWindow?.postMessage(message, window.location.origin);
  }
  function syncTheme(): void {
    const mode = document.documentElement.dataset.theme;
    send({
      type: `${projectId}:theme`,
      theme:
        mode === 'dark' || (mode !== 'light' && systemDark.matches)
          ? 'dark'
          : 'light',
    });
  }
  frame.addEventListener('load', () => {
    syncTheme();
    if (showInitialResult) {
      showInitialResult = false;
      send({ type: `${projectId}:show-result` });
    }
  });
  new MutationObserver(syncTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  systemDark.addEventListener('change', syncTheme);

  function setSize(width: number, height: number): void {
    browser.style.width = `${Math.max(Math.min(320, stage.clientWidth), Math.min(stage.clientWidth, width))}px`;
    browser.style.height = `${Math.max(360, Math.min(860, height))}px`;
  }
  handle.addEventListener('pointerdown', (event) => {
    const bounds = browser.getBoundingClientRect();
    drag = {
      pointerId: event.pointerId,
      x: event.clientX,
      y: event.clientY,
      width: bounds.width,
      height: bounds.height,
    };
    handle.setPointerCapture(event.pointerId);
    browser.classList.add('resizing');
    event.preventDefault();
  });
  handle.addEventListener('pointermove', (event) => {
    if (!drag || event.pointerId !== drag.pointerId) return;
    // The window stays centered, so both horizontal edges move while resizing.
    setSize(
      drag.width + 2 * (event.clientX - drag.x),
      drag.height + event.clientY - drag.y,
    );
  });
  const stopResizing = () => {
    drag = null;
    browser.classList.remove('resizing');
  };
  handle.addEventListener('pointerup', stopResizing);
  handle.addEventListener('pointercancel', stopResizing);
  handle.addEventListener('lostpointercapture', stopResizing);
  handle.addEventListener('keydown', (event) => {
    const step = event.shiftKey ? 64 : 24;
    const bounds = browser.getBoundingClientRect();
    if (event.key === 'ArrowLeft') setSize(bounds.width - step, bounds.height);
    else if (event.key === 'ArrowRight')
      setSize(bounds.width + step, bounds.height);
    else if (event.key === 'ArrowUp')
      setSize(bounds.width, bounds.height - step);
    else if (event.key === 'ArrowDown')
      setSize(bounds.width, bounds.height + step);
    else return;
    event.preventDefault();
  });

  function isDemoMessage(value: unknown): value is DemoMessage {
    if (!value || typeof value !== 'object' || !('type' in value)) return false;
    return (
      value.type === `${projectId}:state` &&
      'phase' in value &&
      (value.phase === 'form' ||
        value.phase === 'processing' ||
        value.phase === 'ready')
    );
  }
  window.addEventListener('message', (event: MessageEvent<unknown>) => {
    if (
      event.origin !== window.location.origin ||
      event.source !== frame.contentWindow ||
      !isDemoMessage(event.data)
    )
      return;
    const previous = phase;
    phase = event.data.phase;
    if (phase === 'processing' && previous !== 'processing') {
      activeRun = crypto.randomUUID();
      mail.start(activeRun, projectId);
    }
    if (phase === 'ready' && activeRun) mail.complete(activeRun);
    if (phase === 'form') {
      activeRun = null;
    }
  });
</script>
