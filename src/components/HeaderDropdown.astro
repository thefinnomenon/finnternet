---
import PixelIcon from './PixelIcon.astro';

interface Props {
  id: string;
  label: string;
  align?: 'start' | 'end';
  class?: string;
}
const { id, label, align = 'end', class: className } = Astro.props;
---

<div
  class:list={['header-dropdown', className]}
  data-header-dropdown
  data-align={align}
>
  <button
    type="button"
    class="header-dropdown-trigger"
    popovertarget={id}
    aria-controls={id}
    aria-expanded="false"
    aria-label={label}
    title={label}
    data-header-dropdown-trigger
    data-label={label}
  >
    <slot name="trigger" />
    <PixelIcon name="chevron-down" size={12} class="dropdown-chevron" />
  </button>
  <div id={id} class="header-dropdown-panel" popover="auto">
    <slot />
  </div>
</div>
