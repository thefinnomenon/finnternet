---
import '../../styles/demos/whistle.css';
import { games, teamImage, scheduleDays } from '../../lib/demos/whistle/model';
import WhistleIcon from '../../components/demos/WhistleIcon.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Whistle</title>
    <script is:inline>
      (() => {
        const theme = matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <aside
      id="whistle-notification"
      class="push-notification"
      aria-label="Whistle push notification"
      hidden
    >
      <button
        type="button"
        id="whistle-dismiss-notification"
        aria-label="Dismiss notification"
      >
        <WhistleIcon name="close" />
      </button>
      <button
        type="button"
        id="whistle-open-notification"
        class="push-preview"
        aria-expanded="false"
        aria-controls="whistle-notification-expanded"
      >
        <span class="push-app">
          <img src="/demos/whistle/icon.png" alt="" width="24" height="24" />
          <strong>Whistle</strong>
          <span>now</span>
        </span>
        <span
          id="whistle-notification-preview"
          class="push-preview-question"
        ></span>
        <span class="push-preview-hint">Tap to answer</span>
      </button>
      <div id="whistle-notification-expanded" hidden>
        <div
          id="whistle-countdown"
          class="push-countdown"
          role="timer"
          aria-label="Time remaining"
          aria-live="off"
        >
          <svg viewBox="0 0 72 72" aria-hidden="true">
            <circle class="countdown-track" cx="36" cy="36" r="30" />
            <circle
              id="whistle-countdown-ring"
              class="countdown-progress"
              cx="36"
              cy="36"
              r="30"
              pathLength="1"
            />
          </svg>
          <span>
            <span id="whistle-countdown-seconds">30</span>
            <span class="sr-only"> seconds</span>
          </span>
        </div>
        <h2 id="whistle-notification-title"></h2>
        <div id="whistle-notification-choices" class="push-choices"></div>
      </div>
    </aside>
    <main class="whistle-app" id="whistle-app">
      <section id="whistle-home" aria-label="Games">
        <header class="home-header">
          <h1 class="brand">
            <img src="/demos/whistle/icon.png" width="32" height="32" alt="" />
            Whistle
          </h1>
          <div class="home-tools">
            <button
              class="icon-button"
              data-settings
              aria-label="Settings"
              title="Settings"
            >
              <WhistleIcon name="settings" />
            </button>
          </div>
        </header>
        <nav class="sport-switch" aria-label="Sport">
          {(
            [
              { sport: 'basketball', label: 'Basketball', supported: true },
              { sport: 'football', label: 'Football', supported: true },
              { sport: 'soccer', label: 'Soccer', supported: false },
              { sport: 'baseball', label: 'Baseball', supported: false },
            ] as const
          ).map(({ sport, label, supported }) => (
            <button
              type="button"
              data-sport={supported ? sport : undefined}
              aria-pressed={supported ? sport === 'basketball' : undefined}
              aria-label={supported ? label : `${label} (not available)`}
              title={supported ? label : `${label} (not available)`}
              disabled={!supported}
            >
              <WhistleIcon name={sport} />
            </button>
          ))}
        </nav>
        <nav class="date-strip" aria-label="Game date">
          {scheduleDays.map(({ label, day }) => (
            <button class="day" data-day={day} aria-pressed={day === 14}>
              <span>{label}</span>
              <span>{day}</span>
            </button>
          ))}
        </nav>
        <div class="games" id="whistle-games">
          {games.map((game) => (
            <article
              class="game-card"
              data-game-card={game.id}
              data-card-day={game.day}
              data-card-sport={game.sport}
              hidden={game.day !== 14 || game.sport !== 'basketball'}
            >
              <div class="card-teams">
                <div class="team">
                  <img
                    src={teamImage(game.away, game)}
                    width="64"
                    height="64"
                    alt=""
                  />
                  <strong>{game.away}</strong>
                </div>
                <b class="versus">vs</b>
                <div class="team">
                  <img
                    src={teamImage(game.home, game)}
                    width="64"
                    height="64"
                    alt=""
                  />
                  <strong>{game.home}</strong>
                </div>
              </div>
              <div class="card-info">
                <strong>{game.time}</strong>
                <span class="game-value">
                  ${game.prize.toLocaleString('en-US')}
                </span>
                <span
                  class="player-count"
                  aria-label={`${game.players} players`}
                >
                  <WhistleIcon name="people" />
                  <span data-player-count={game.id}>{game.players}</span>
                </span>
                <button
                  class="primary"
                  data-open-game={game.id}
                  aria-label={`Join ${game.away} vs ${game.home}`}
                >
                  Join
                </button>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section id="whistle-game" aria-label="Game predictions" hidden>
        <header class="game-header">
          <button class="icon-button" data-home aria-label="Back to games">
            <WhistleIcon name="back" />
          </button>
          <h1 class="game-matchup" id="whistle-game-title" tabindex="-1"></h1>
          <span></span>
        </header>
        <div class="game-info">
          <span aria-label="Your score">
            <WhistleIcon name="score" />
            <strong id="whistle-score">0</strong>
          </span>
          <span aria-label="Players">
            <WhistleIcon name="people" />
            <span id="whistle-game-players"></span>
          </span>
          <span aria-label="Game prize">
            $<span id="whistle-game-prize"></span>
          </span>
          <button
            class="icon-button"
            id="whistle-open-leaderboard"
            aria-label="Leaderboard"
            title="Leaderboard"
          >
            <WhistleIcon name="trophy" />
          </button>
        </div>
        <div id="whistle-questions" class="question-list"></div>
      </section>
      <section
        id="whistle-leaderboard"
        aria-labelledby="whistle-leaderboard-title"
        hidden
      >
        <header class="screen-header">
          <button
            class="icon-button"
            id="whistle-back-game"
            aria-label="Back to predictions"
          >
            <WhistleIcon name="back" />
          </button>
          <h1 id="whistle-leaderboard-title" tabindex="-1">
            Leaderboard
          </h1>
          <span></span>
        </header>
        <table class="leaderboard">
          <thead>
            <tr>
              <th scope="col">Place</th>
              <th scope="col">Player</th>
              <th scope="col">Score</th>
            </tr>
          </thead>
          <tbody id="whistle-rankings"></tbody>
        </table>
      </section>
      <section
        id="whistle-settings"
        aria-labelledby="whistle-settings-title"
        hidden
      >
        <header class="settings-header">
          <h1 id="whistle-settings-title" tabindex="-1">
            Settings
          </h1>
          <button
            class="icon-button"
            id="whistle-back-settings"
            aria-label="Close settings"
          >
            <WhistleIcon name="close" />
          </button>
        </header>
        <div class="settings-content">
          <section
            class="settings-section"
            aria-labelledby="whistle-account-title"
          >
            <h2 id="whistle-account-title">Account</h2>
            <dl class="settings-card account-details">
              <div>
                <dt>Username</dt>
                <dd>Awesome User</dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd>user@finnternet.com</dd>
              </div>
            </dl>
          </section>
          <section
            class="settings-section"
            aria-labelledby="whistle-winnings-title"
          >
            <h2 id="whistle-winnings-title">Winnings</h2>
            <div class="settings-card winnings-card">
              <div class="winnings-balance">
                <span>Total Winnings</span>
                <strong>$0.00</strong>
              </div>
              <button type="button" class="withdraw-button" disabled>
                Minimum $10 to Withdraw
              </button>
            </div>
          </section>
          <section
            class="settings-section"
            aria-labelledby="whistle-preferences-title"
          >
            <h2 id="whistle-preferences-title">Preferences</h2>
            <div class="settings-card">
              <button
                type="button"
                id="whistle-appearance"
                class="settings-row"
                aria-label="Appearance: Auto"
              >
                <span class="settings-row-label">
                  <span data-appearance-icon="light">
                    <WhistleIcon name="sun" />
                  </span>
                  <span data-appearance-icon="dark" hidden>
                    <WhistleIcon name="moon" />
                  </span>
                  Appearance
                </span>
                <span class="settings-row-value">
                  <span id="whistle-theme-label">Auto</span>
                  <WhistleIcon name="chevron" />
                </span>
              </button>
            </div>
          </section>
          <section
            class="settings-section"
            aria-labelledby="whistle-actions-title"
          >
            <h2 id="whistle-actions-title">Actions</h2>
            <div class="settings-actions">
              <button class="settings-row settings-card" type="button" disabled>
                <span>Competition rules</span>
                <WhistleIcon name="rules" />
              </button>
              <button class="settings-row settings-card" type="button" disabled>
                <span>Submit feedback</span>
                <WhistleIcon name="feedback" />
              </button>
              <button class="settings-row settings-card" type="button" disabled>
                <span>Support</span>
                <WhistleIcon name="mail" />
              </button>
              <button class="settings-row settings-card" type="button" disabled>
                <span>Sign Out</span>
                <WhistleIcon name="signout" />
              </button>
            </div>
          </section>
          <section
            class="settings-section"
            aria-labelledby="whistle-danger-title"
          >
            <h2 id="whistle-danger-title">Danger Zone</h2>
            <button type="button" class="delete-account" disabled>
              Delete Account
            </button>
          </section>
          <p class="version">Whistle v2.0.6</p>
        </div>
      </section>
      <p
        id="whistle-announcement"
        class="sr-only"
        role="status"
        aria-live="polite"
      ></p>
    </main>

    <noscript>
      <p class="no-script">
        Enable JavaScript to join a game and make predictions.
      </p>
    </noscript>
    <script>
      import '../../lib/demos/whistle/client';
    </script>
  </body>
</html>
