---
import '../../styles/demos/whistle.css';
import { games } from '../../lib/demos/whistle/model';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Whistle</title>
    <script is:inline>
      (() => {
        let theme = matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        try {
          const saved = localStorage.getItem('finnternet-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {
          /* Follow system appearance when storage is unavailable. */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <main class="whistle-app" id="whistle-app">
      <section id="whistle-home" aria-label="Games">
        <header class="home-header">
          <h1 class="brand">
            <img src="/demos/whistle/icon.png" width="32" height="32" alt="" />
            Whistle
          </h1>
          <div class="home-tools">
            <span class="balance" aria-label="1240 Whistle points">
              ◉ 1,240
            </span>
            <button
              class="icon-button"
              data-settings
              aria-label="Settings"
              title="Settings"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 3-1 3-3 1-2 4 2 2v4l4 2 3-1 3 1 4-2v-4l2-2-2-4-3-1-1-3h-6Z" />
                <circle cx="12" cy="11" r="3" />
              </svg>
            </button>
          </div>
        </header>
        <nav class="date-strip" aria-label="Game date">
          {[
            { label: 'SAT', day: 14 },
            { label: 'SUN', day: 15 },
            { label: 'MON', day: 16 },
          ].map(({ label, day }) => (
            <button class="day" data-day={day} aria-pressed={day === 14}>
              <span>{label}</span>
              <span>{day}</span>
            </button>
          ))}
        </nav>
        <div class="games" id="whistle-games">
          {games.map((game) => (
            <article
              class="game-card"
              data-game-card={game.id}
              data-card-day={game.day}
              hidden={game.day !== 14}
            >
              <div class="card-teams">
                <div class="team">
                  <img
                    src={`/demos/whistle/${game.away}.png`}
                    width="64"
                    height="64"
                    alt=""
                  />
                  <strong>{game.away}</strong>
                </div>
                <b class="versus">vs</b>
                <div class="team">
                  <img
                    src={`/demos/whistle/${game.home}.png`}
                    width="64"
                    height="64"
                    alt=""
                  />
                  <strong>{game.home}</strong>
                </div>
              </div>
              <div class="card-info">
                <strong>{game.time}</strong>
                <span>♜ ◉ {game.prize}</span>
                <span class="player-count">♧ 3</span>
                <button
                  class="primary"
                  data-open-game={game.id}
                  aria-label={`Join ${game.away} vs ${game.home}`}
                >
                  Join
                </button>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section
        id="whistle-lobby"
        class="lobby"
        aria-labelledby="whistle-lobby-title"
        hidden
      >
        <header class="screen-header">
          <button class="icon-button" data-home aria-label="Back to games">
            ←
          </button>
          <h1 id="whistle-lobby-title" tabindex="-1">
            Game lobby
          </h1>
          <button class="icon-button" data-settings aria-label="Settings">
            ⚙
          </button>
        </header>
        <div class="lobby-teams" id="whistle-lobby-teams"></div>
        <div class="lobby-details">
          <strong class="lobby-prize" id="whistle-lobby-prize"></strong>
          <span class="lobby-players">♧ 3</span>
          <div class="lobby-date">
            <span id="whistle-lobby-date"></span>
            <span id="whistle-lobby-time"></span>
          </div>
        </div>
        <button class="primary join-game" id="whistle-join">
          JOIN GAME
        </button>
      </section>
      <section id="whistle-game" aria-label="Game predictions" hidden>
        <header class="game-header">
          <button class="icon-button" data-home aria-label="Back to games">
            ←
          </button>
          <h1 class="game-matchup" id="whistle-game-title" tabindex="-1"></h1>
          <button
            class="icon-button"
            id="whistle-leave"
            aria-label="Leave game"
            title="Leave game"
          >
            ⇥
          </button>
        </header>
        <div class="game-info">
          <span aria-label="Your score">
            ★ <strong id="whistle-score">0</strong>
          </span>
          <span aria-label="Players">♧ 4</span>
          <span aria-label="Whistle point prize">
            ◉ <span id="whistle-game-prize"></span>
          </span>
          <button
            class="icon-button"
            id="whistle-open-leaderboard"
            aria-label="Leaderboard"
            title="Leaderboard"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 3h10v5a5 5 0 0 1-10 0V3ZM7 5H3v3a4 4 0 0 0 5 4m9-7h4v3a4 4 0 0 1-5 4m-4 1v6m-4 2h8" />
            </svg>
          </button>
        </div>
        <div id="whistle-questions" class="question-list"></div>
      </section>
      <section
        id="whistle-leaderboard"
        aria-labelledby="whistle-leaderboard-title"
        hidden
      >
        <header class="screen-header">
          <button
            class="icon-button"
            id="whistle-back-game"
            aria-label="Back to predictions"
          >
            ←
          </button>
          <h1 id="whistle-leaderboard-title" tabindex="-1">
            Leaderboard
          </h1>
          <span></span>
        </header>
        <table class="leaderboard">
          <thead>
            <tr>
              <th scope="col">Place</th>
              <th scope="col">Player</th>
              <th scope="col">Points</th>
            </tr>
          </thead>
          <tbody id="whistle-rankings"></tbody>
        </table>
      </section>
      <section
        id="whistle-settings"
        aria-labelledby="whistle-settings-title"
        hidden
      >
        <header class="screen-header">
          <button
            class="icon-button"
            id="whistle-back-settings"
            aria-label="Back"
          >
            ←
          </button>
          <h1 id="whistle-settings-title" tabindex="-1">
            Settings
          </h1>
          <span></span>
        </header>
        <div class="account">
          <h2>Account</h2>
          <dl>
            <div>
              <dt>Username</dt>
              <dd>Awesome User</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd>user@finnternet.com</dd>
            </div>
          </dl>
          <p class="version">Whistle v2.0.6</p>
        </div>
      </section>
      <p
        id="whistle-announcement"
        class="sr-only"
        role="status"
        aria-live="polite"
      ></p>
    </main>
    <dialog
      id="whistle-answer-dialog"
      aria-labelledby="whistle-question-title"
      aria-describedby="whistle-question-points"
    >
      <button
        class="dialog-close icon-button"
        id="whistle-close-question"
        aria-label="Close question"
      >
        ×
      </button>
      <h2 id="whistle-question-title"></h2>
      <p id="whistle-question-points"></p>
      <div id="whistle-choices" class="choices"></div>
    </dialog>
    <noscript>
      <p class="no-script">
        Enable JavaScript to join a game and make predictions.
      </p>
    </noscript>
    <script>
      import '../../lib/demos/whistle/client';
    </script>
  </body>
</html>
