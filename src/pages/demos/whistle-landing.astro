<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Whistle - Live sports questions in real time</title>
    <meta
      name="description"
      content="Whistle is a real-time prediction app for live sports. Answer questions during the game and see results instantly."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #0b1020;
        --bg-2: #101a33;
        --card: #131b32;
        --ink: #f7f9ff;
        --muted: #b8c0d9;
        --accent: #2f6bff;
        --accent-2: #ffb020;
        --line: rgba(255, 255, 255, 0.08);
        --shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
        --radius: 22px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(
            1100px 600px at 20% -10%,
            rgba(47, 107, 255, 0.35),
            transparent 60%
          ),
          radial-gradient(
            900px 500px at 100% 0%,
            rgba(255, 176, 32, 0.25),
            transparent 55%
          ),
          linear-gradient(180deg, var(--bg), var(--bg-2));
        min-height: 100vh;
      }

      .page {
        overflow: hidden;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 28px clamp(20px, 6vw, 80px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: 0.5px;
      }

      .brand-mark {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        background: #ffffff;
        border-radius: 12px;
      }

      .brand img {
        width: 38px;
        height: 38px;
      }

      .pill {
        border: 1px solid var(--line);
        color: var(--muted);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.8fr) minmax(220px, 1fr);
        gap: 18px;
        align-items: center;
        padding: 24px clamp(20px, 6vw, 80px) 52px;
      }

      .hero-copy {
        max-width: 980px;
      }

      .hero-media {
        border-radius: var(--radius);
        overflow: hidden;
        background: #050912;
        box-shadow: var(--shadow);
        justify-self: center;
        width: min(210px, 100%);
        aspect-ratio: 1179 / 2556;
      }

      .hero-media video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(36px, 5vw, 64px);
        margin: 0 0 18px;
        line-height: 1.05;
      }

      .hero p {
        color: var(--muted);
        font-size: clamp(16px, 2vw, 20px);
        line-height: 1.6;
        margin: 0 0 24px;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 22px;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
        color: var(--ink);
        background: var(--accent);
        box-shadow: var(--shadow);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .btn.secondary {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--muted);
        box-shadow: none;
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 22px 60px rgba(22, 48, 120, 0.35);
      }

      .strip {
        display: flex;
        gap: 18px;
        align-items: center;
        margin-top: 24px;
      }

      .strip span {
        background: rgba(255, 255, 255, 0.08);
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 13px;
        color: var(--muted);
      }

      .steps {
        display: grid;
        gap: 34px;
        padding: 0 clamp(20px, 6vw, 80px) 80px;
      }

      .steps-title {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(30px, 4vw, 44px);
      }

      .step {
        display: grid;
        grid-template-columns: minmax(100px, 180px) 1fr;
        gap: clamp(20px, 4vw, 52px);
        align-items: center;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: clamp(16px, 2vw, 26px);
        background: linear-gradient(
          160deg,
          rgba(255, 255, 255, 0.04),
          rgba(255, 255, 255, 0.01)
        );
      }

      .step.reverse {
        grid-template-columns: 1fr minmax(100px, 180px);
      }

      .step img,
      .step video {
        width: 100%;
        border-radius: 28px;
        display: block;
      }

      .step h3 {
        font-family: 'Space Grotesk', sans-serif;
        margin: 0 0 8px;
        font-size: clamp(26px, 3.5vw, 34px);
      }

      .step p {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
      }

      .callout {
        margin: 60px clamp(20px, 6vw, 80px) 0;
        background: linear-gradient(
          135deg,
          rgba(47, 107, 255, 0.2),
          rgba(255, 176, 32, 0.15)
        );
        border-radius: var(--radius);
        padding: 28px 30px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: center;
        justify-content: space-between;
      }

      .callout h2 {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
      }

      .callout p {
        margin: 6px 0 0;
        color: var(--muted);
      }

      footer {
        padding: 50px clamp(20px, 6vw, 80px);
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: space-between;
        color: var(--muted);
        border-top: 1px solid var(--line);
        margin-top: 80px;
      }

      footer a {
        color: var(--muted);
        text-decoration: none;
      }

      .fade-in {
        animation: fadeUp 0.9s ease forwards;
        opacity: 0;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 720px) {
        header {
          flex-direction: column;
          gap: 14px;
        }

        .hero {
          grid-template-columns: 1fr;
        }

        .hero-media {
          order: 1;
        }

        .hero-copy {
          order: 2;
        }

        .hero .cta-row {
          width: 100%;
          flex-wrap: nowrap;
          justify-content: center;
          gap: 8px;
        }

        .hero .cta-row .btn {
          flex: 1;
          min-width: 0;
          padding: 6px;
          justify-content: center;
        }

        .hero .cta-row .btn img {
          width: 100%;
          height: auto !important;
          max-width: 150px;
        }

        .step,
        .step.reverse {
          grid-template-columns: 1fr;
        }

        .step > div {
          order: 1;
        }

        .step > img,
        .step > video {
          order: 2;
          width: 180px;
          justify-self: center;
        }

        .callout .cta-row {
          width: 100%;
          flex-wrap: nowrap;
          justify-content: center;
          gap: 8px;
        }

        .callout .cta-row .btn {
          flex: 1;
          min-width: 0;
          padding: 6px;
          justify-content: center;
        }

        .callout .cta-row .btn img {
          width: 100%;
          height: auto !important;
          max-width: 150px;
        }
      }
      .play-demo {
        border: 0;
        font: inherit;
        cursor: pointer;
      }
      button:focus-visible,
      a:focus-visible {
        outline: 3px solid #ffb020;
        outline-offset: 4px;
      }
      @media (max-width: 720px) {
        .hero .cta-row,
        .callout .cta-row {
          flex-wrap: wrap;
        }
        .hero .cta-row .play-demo,
        .callout .cta-row .play-demo {
          flex-basis: 100%;
          padding: 14px 22px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .fade-in {
          animation: none;
          opacity: 1;
        }
        .btn {
          transition: none;
        }
      }
      a[aria-disabled='true'] {
        cursor: default;
      }
      .btn[aria-disabled='true']:hover {
        transform: none;
        box-shadow: none;
      }
      html,
      body {
        scrollbar-width: none;
      }
      html::-webkit-scrollbar,
      body::-webkit-scrollbar {
        display: none;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <div class="brand">
          <span class="brand-mark">
            <img
              src="/demos/whistle/landing/images/whistle-icon.png"
              alt="Whistle logo"
            />
          </span>
          <span>Whistle</span>
        </div>
      </header>

      <section class="hero">
        <div class="hero-copy fade-in">
          <h1>Make live predictions & win big!</h1>
          <p>
            Whistle drops real-time questions during games using push
            notifications. Join a game, answer questions as the action unfolds,
            and get the most right to win prizes.
          </p>
          <div class="cta-row">
            <button class="btn play-demo" type="button" data-play-demo>
              <svg
                viewBox="0 0 20 20"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path fill="currentColor" d="M6 3.5 16 10 6 16.5Z" />
              </svg>
              Play demo
            </button>
            <a
              role="link"
              aria-disabled="true"
              class="btn secondary"
              aria-label="Download on the App Store"
            >
              <img
                src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
                alt="Download on the App Store"
                style="height: 44px"
              />
            </a>
            <a
              role="link"
              aria-disabled="true"
              class="btn secondary"
              aria-label="Get it on Google Play"
            >
              <img
                src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
                alt="Get it on Google Play"
                style="height: 54px"
              />
            </a>
          </div>
        </div>
        <div class="hero-media fade-in">
          <video
            src="/demos/whistle/landing/video/promo.mp4"
            controls
            controlslist="nofullscreen"
            loop
            playsinline
            preload="metadata"
            aria-label="Whistle promo video"
          ></video>
        </div>
      </section>

      <section id="how-it-works" class="steps">
        <h2 class="steps-title">How it Works</h2>
        <article class="step fade-in">
          <img
            src="/demos/whistle/landing/images/ios_join.png"
            alt="Join a live game from the Whistle question screen"
          />
          <div>
            <h3>Join</h3>
            <p>
              Pick a live matchup and jump in before tipoff or kickoff. You are
              in with one tap, and Whistle will notify you when the game starts.
            </p>
          </div>
        </article>
        <article class="step reverse fade-in">
          <div>
            <h3>Play</h3>
            <p>
              Questions appear during key moments, and you answer fast, directly
              from the notification by long pressing it, while the game is
              unfolding. Every pick is locked before the next play.
            </p>
          </div>
          <video
            src="/demos/whistle/landing/video/ios_play.mp4"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            aria-label="Play live by answering real-time questions"
          ></video>
        </article>
        <article class="step fade-in">
          <video
            src="/demos/whistle/landing/video/win.mp4"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            aria-label="Win by stacking correct answers in Whistle"
          ></video>
          <div>
            <h3>Win</h3>
            <p>
              Rack up points as outcomes resolve instantly, climb the
              leaderboard, and finish on top by reading the biggest moments
              correctly.
            </p>
          </div>
        </article>
      </section>

      <section id="download" class="callout">
        <div>
          <h2>Ready for your next game?</h2>
          <p>
            Download Whistle and get questions the moment the action heats up.
          </p>
        </div>
        <div class="cta-row">
          <button class="btn play-demo" type="button" data-play-demo>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M6 3.5 16 10 6 16.5Z" />
            </svg>
            Play demo
          </button>
          <a
            role="link"
            aria-disabled="true"
            class="btn secondary"
            aria-label="Download on the App Store"
          >
            <img
              src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
              alt="Download on the App Store"
              style="height: 44px"
            />
          </a>
          <a
            role="link"
            aria-disabled="true"
            class="btn secondary"
            aria-label="Get it on Google Play"
          >
            <img
              src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
              alt="Get it on Google Play"
              style="height: 54px"
            />
          </a>
        </div>
      </section>

      <footer>
        <span>Whistle</span>
        <div>
          <a role="link" aria-disabled="true">
            Privacy
          </a>
          <span> | </span>
          <a role="link" aria-disabled="true">
            Testers
          </a>
          <span> | </span>
          <a role="link" aria-disabled="true">
            Support
          </a>
        </div>
      </footer>
    </div>
    <script is:inline>
      document.querySelectorAll('[data-play-demo]').forEach((button) => {
        button.addEventListener('click', () =>
          window.parent.postMessage({ type: 'whistle:play' }, location.origin),
        );
      });
      window.addEventListener('message', (event) => {
        if (
          event.origin !== location.origin ||
          event.source !== window.parent ||
          !event.data ||
          typeof event.data !== 'object'
        )
          return;
        if (event.data.type === 'whistle:pause-media')
          document.querySelectorAll('video').forEach((video) => video.pause());
        if (event.data.type === 'whistle:focus-play')
          document
            .querySelector('[data-play-demo]')
            ?.focus({ preventScroll: true });
      });
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video[autoplay]').forEach((video) => {
          video.autoplay = false;
          video.pause();
          video.controls = true;
        });
      }
    </script>
  </body>
</html>
