---
import { readFileSync } from 'node:fs';

const assets: unknown = JSON.parse(
  readFileSync(
    new URL(
      '../../../public/demos/creatorkitchen/app/manifest.json',
      import.meta.url,
    ),
    'utf8',
  ),
);
if (
  !assets ||
  typeof assets !== 'object' ||
  !('javascript' in assets) ||
  typeof assets.javascript !== 'string' ||
  !('stylesheet' in assets) ||
  typeof assets.stylesheet !== 'string'
)
  throw new Error('Build the original CreatorKitchen frontend first.');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'none'; base-uri 'none'; form-action 'none'"
    />
    <title>CreatorKitchen</title>
    <link rel="stylesheet" href={assets.stylesheet} />
  </head>
  <body>
    <div id="creatorkitchen-original"></div>
    <script is:inline type="module" src={assets.javascript}></script>
  </body>
</html>
