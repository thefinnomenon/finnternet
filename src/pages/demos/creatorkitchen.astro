---
import '../../styles/demos/creatorkitchen.css';
import {
  createDraft,
  renderBlocks,
  slugify,
} from '../../lib/demos/creatorkitchen/model';
const draft = createDraft();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'"
    />
    <title>CreatorKitchen</title>
    <script is:inline>
      document.documentElement.dataset.theme = matchMedia(
        '(prefers-color-scheme: dark)',
      ).matches
        ? 'dark'
        : 'light';
    </script>
  </head>
  <body>
    <div id="ck-app" class="ck-app">
      <aside class="ck-sidebar" aria-label="Content">
        <div class="ck-content-heading">
          <h1>Content</h1>
          <button
            id="ck-create"
            type="button"
            class="ck-icon-button"
            aria-label="Create new content"
            title="Create new content"
          >
            ＋
          </button>
        </div>
        <div class="ck-author">
          <span class="ck-avatar" aria-hidden="true">
            AU
          </span>
          Awesome User
        </div>
        <button id="ck-site" class="ck-site-button" type="button">
          awesome.creatorkitchen.net
        </button>
        <nav id="ck-content-list" class="ck-content-list" aria-label="Drafts">
          <button
            type="button"
            class="ck-content-item"
            aria-current="page"
            data-draft="0"
          >
            {draft.title}
          </button>
        </nav>
        <div class="ck-sidebar-footer">CreatorKitchen</div>
      </aside>
      <main id="ck-workspace" class="ck-workspace">
        <div class="ck-topbar">
          <span id="ck-save-status" class="ck-save-status" role="status">
            Saved
          </span>
          <div class="ck-actions">
            <button id="ck-preview" type="button" class="ck-text-button">
              Preview
            </button>
            <button id="ck-publish" type="button" class="ck-primary">
              Publish
            </button>
            <button
              id="ck-view"
              type="button"
              class="ck-icon-button ck-view-button"
              aria-label="View published content"
              title="Publish this content first"
              disabled
            >
              ↗
            </button>
            <button
              id="ck-settings-toggle"
              type="button"
              class="ck-icon-button ck-settings-toggle"
              aria-label="Content settings"
              aria-expanded="false"
              aria-controls="ck-settings"
            >
              ⚙
            </button>
          </div>
        </div>
        <div class="ck-formatbar" role="toolbar" aria-label="Text formatting">
          <button
            type="button"
            data-format="strong"
            aria-label="Bold"
            title="Bold"
          >
            <strong>B</strong>
          </button>
          <button
            type="button"
            data-format="em"
            aria-label="Italic"
            title="Italic"
          >
            <em>I</em>
          </button>
          <span class="ck-toolbar-rule" aria-hidden="true"></span>
          <button type="button" data-style="heading" title="Header 2">
            H₂
          </button>
          <button
            type="button"
            data-style="quote"
            aria-label="Block Quote"
            title="Block Quote"
          >
            ❞
          </button>
          <button
            id="ck-add-tooltip"
            type="button"
            aria-label="Tooltip"
            title="Tooltip"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 4h16v12H9l-5 4V4Z" />
              <path d="M8 8h8m-8 4h5" />
            </svg>
          </button>
          <button
            id="ck-add-audio"
            type="button"
            aria-label="Audio link"
            title="Audio link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m4 9 5 0 5-4v14l-5-4H4V9Zm13-1a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" />
            </svg>
          </button>
          <button id="ck-media" type="button" class="ck-media-button">
            <span aria-hidden="true">▧</span> Media
          </button>
        </div>
        <div class="ck-document-scroll">
          <article class="ck-document">
            <h1 id="ck-document-title">{draft.title}</h1>
            <div
              id="ck-editor"
              class="ck-prose ck-editor"
              role="textbox"
              aria-label="Post content"
              aria-multiline="true"
              contenteditable="true"
              spellcheck="true"
              set:html={renderBlocks(draft.blocks, true)}
            />
            <button id="ck-add-block" class="ck-add-block" type="button">
              ＋ Add a block
            </button>
          </article>
        </div>
        <p id="ck-notice" class="ck-notice" role="status" hidden></p>
      </main>
      <aside
        id="ck-settings"
        class="ck-settings"
        aria-labelledby="ck-settings-heading"
      >
        <h2 id="ck-settings-heading">Content Settings</h2>
        <form id="ck-content-form">
          <div class="ck-settings-fields">
            <label for="ck-title">Title</label>
            <input id="ck-title" value={draft.title} required maxlength="160" />
            <label for="ck-description">Description</label>
            <textarea
              id="ck-description"
              rows="4"
              maxlength="500"
            >{draft.description}</textarea>
            <p class="ck-field-label">URL</p>
            <p id="ck-post-url" class="ck-post-url">
              awesome.creatorkitchen.net/posts/{slugify(draft.title)}
            </p>
          </div>
          <div class="ck-settings-bottom">
            <button type="submit" class="ck-primary">
              SAVE
            </button>
          </div>
        </form>
      </aside>
    </div>
    <section id="ck-reader" class="ck-reader" aria-label="Post preview" hidden>
      <div class="ck-reader-bar">
        <button id="ck-back" type="button" class="ck-text-button">
          ← Back to editor
        </button>
        <span id="ck-reader-mode">Preview</span>
        <button id="ck-reader-publish" type="button" class="ck-primary">
          Publish
        </button>
      </div>
      <div class="ck-reader-site" id="ck-reader-site">
        Language notes
      </div>
      <article class="ck-reader-document">
        <h1 id="ck-reader-title" tabindex="-1"></h1>
        <div id="ck-reader-body" class="ck-prose"></div>
        <footer class="ck-reader-author">
          <span class="ck-avatar" aria-hidden="true">
            AU
          </span>
          <span>Awesome User</span>
        </footer>
      </article>
    </section>
    <dialog
      id="ck-media-dialog"
      class="ck-dialog"
      aria-labelledby="ck-media-heading"
    >
      <div class="ck-dialog-heading">
        <h2 id="ck-media-heading">Media</h2>
        <button
          type="button"
          class="ck-icon-button"
          data-close="ck-media-dialog"
          aria-label="Close media"
        >
          ×
        </button>
      </div>
      <div class="ck-media-choices">
        <button type="button" data-asset-choice="desk">
          <img
            src="/demos/creatorkitchen/desk.svg"
            width="480"
            height="270"
            alt="Open notebook and coffee on a sunlit desk"
          />
          <span>A little space</span>
        </button>
        <button type="button" data-asset-choice="garden">
          <img
            src="/demos/creatorkitchen/garden.svg"
            width="480"
            height="270"
            alt="Green hills and a warm sun"
          />
          <span>Fresh perspective</span>
        </button>
      </div>
    </dialog>
    <dialog
      id="ck-site-dialog"
      class="ck-dialog"
      aria-labelledby="ck-site-heading"
    >
      <div class="ck-dialog-heading">
        <h2 id="ck-site-heading">Site Settings</h2>
        <button
          type="button"
          class="ck-icon-button"
          data-close="ck-site-dialog"
          aria-label="Close site settings"
        >
          ×
        </button>
      </div>
      <form id="ck-site-form" class="ck-site-form">
        <label for="ck-site-title">Site Name</label>
        <input
          id="ck-site-title"
          value="Language notes"
          required
          maxlength="100"
        />
        <label for="ck-subdomain">Subdomain</label>
        <div class="ck-subdomain">
          <input
            id="ck-subdomain"
            value="awesome"
            pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
            required
            maxlength="40"
          />
          <span>.creatorkitchen.net</span>
        </div>
        <label for="ck-site-description">Description</label>
        <textarea
          id="ck-site-description"
          rows="3"
          maxlength="300"
        >Notes, questions, and things worth sharing.</textarea>
        <button type="submit" class="ck-primary">
          SAVE
        </button>
      </form>
    </dialog>
    <dialog
      id="ck-annotation-dialog"
      class="ck-dialog"
      aria-labelledby="ck-annotation-heading"
    >
      <div class="ck-dialog-heading">
        <h2 id="ck-annotation-heading">Tooltip</h2>
        <button
          type="button"
          class="ck-icon-button"
          data-close="ck-annotation-dialog"
          aria-label="Close annotation"
        >
          ×
        </button>
      </div>
      <form id="ck-annotation-form" class="ck-annotation-form">
        <p id="ck-annotation-selection" class="ck-annotation-selection"></p>
        <div id="ck-tooltip-fields">
          <label for="ck-tooltip-text">Tooltip text</label>
          <input id="ck-tooltip-text" maxlength="300" required />
        </div>
        <div id="ck-audio-fields" hidden>
          <label for="ck-audio-file">Audio file</label>
          <div class="ck-audio-choice">
            <select id="ck-audio-file">
              <option value="hello">ola-tudo-bem.mp3</option>
              <option value="thanks">obrigado.mp3</option>
            </select>
            <button
              id="ck-play-selected-audio"
              type="button"
              class="ck-icon-button"
              data-audio-clip="hello"
              aria-label="Play audio"
              aria-pressed="false"
              title="Play audio"
            >
              ▶
            </button>
          </div>
        </div>
        <div class="ck-annotation-actions">
          <button
            id="ck-remove-annotation"
            type="button"
            class="ck-text-button"
            hidden
          >
            Remove
          </button>
          <button type="submit" class="ck-primary">
            Save
          </button>
        </div>
      </form>
    </dialog>
    <div
      id="ck-inline-tooltip"
      class="ck-inline-tooltip"
      role="tooltip"
      hidden
    ></div>
    <audio id="ck-audio-player" preload="none"></audio>
    <p id="ck-audio-error" class="ck-audio-error" role="alert" hidden>
      Couldn’t play audio. Try again.
    </p>
    <script>
      import { initCreatorKitchen } from '../../lib/demos/creatorkitchen/client';
      initCreatorKitchen();
    </script>
  </body>
</html>
