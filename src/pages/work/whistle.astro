---
import Base from '../../layouts/Base.astro';
import ProjectLayout from '../../components/ProjectLayout.astro';
import WhistleDemo from '../../components/demos/WhistleDemo.astro';
import ProjectDetails from '../../components/ProjectDetails.astro';
import { whistleWork } from '../../lib/portfolio';
import { translations } from '../../lib/i18n';

const stack = [
  {
    label: 'Mobile app',
    tools: 'Expo, React Native, React, TypeScript, NativeWind, Expo Router',
  },
  {
    label: 'Backend & data',
    tools: 'Node.js, Express, Firebase Auth, Firestore, Firebase Admin',
  },
  {
    label: 'Live game engine',
    tools:
      'NBA live feeds, ESPN NFL feeds, EntitySport, question generation, weighted scoring',
  },
  {
    label: 'Delivery & operations',
    tools:
      'FCM, native iOS notification extensions, Android notifications, Expo EAS, Sentry, Mixpanel',
  },
];
const description = translations.en[whistleWork.descriptionKey];
const features = [
  'Browse sports games, join a game lobby and compete against other players.',
  'Answer short predictions about the next play, a player or the rest of a period.',
  'Generate and resolve questions for sports events using real-time data feeds and game state.',
  'Receive actionable push notifications and answer directly through custom native notification interfaces.',
  'Track and minimize end-to-end latency, from live data feeds to question delivery and player responses, to fit more real-time questions into each game.',
  'Use administration tools, analytics and stored game replays to inspect question timing and resolution, and improve gameplay and mechanics.',
];
---

<Base
  title="Whistle"
  description={description}
  locale="en"
  path="work/whistle"
  alternates={{ en: '/work/whistle/' }}
>
  <ProjectLayout>
    <ProjectDetails
      slot="details"
      title={whistleWork.company}
      description={description}
      experience={{
        role: translations.en[whistleWork.roleKey],
        startedOn: whistleWork.startedOn,
        endedOn: whistleWork.endedOn,
      }}
      website="https://whistlesports.net/"
      inactive
      github="https://github.com/thefinnomenon/whistle-public"
      stack={stack}
      features={features}
    />
    <WhistleDemo slot="demo" />
  </ProjectLayout>
</Base>
