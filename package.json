{
  "name": "finnternet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run build:creatorkitchen && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "wrangler deploy",
    "check": "astro check",
    "test": "node --experimental-strip-types --test src/lib/fmail.test.ts src/lib/demos/*/*.test.ts demos/creatorkitchen/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:creatorkitchen": "node scripts/build-creatorkitchen.mjs",
    "predev": "npm run build:creatorkitchen"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/solid-js": "^7.1.2",
    "astro": "^7.4.5",
    "d3-geo": "^3.1.2",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "~3.2.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
